# ---------------------------------------------------------------------------
# Discord sign-in  (auth.ts)  — REQUIRED for admin access
# ---------------------------------------------------------------------------
# From https://discord.com/developers/applications -> your app -> OAuth2.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Any random 32+ character string. Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Your deployed origin, e.g. https://mattyspins.up.railway.app
# Only needed in production; omit locally.
AUTH_URL=

# ---------------------------------------------------------------------------
# Who gets into /admin  (lib/admin.ts)
# ---------------------------------------------------------------------------
# Numeric Discord user IDs, comma-separated. Right-click your name in Discord
# with Developer Mode on -> "Copy User ID".
#
# Owner  = everything, including prize tables, games config and RTP.
# Mod    = redemptions, giveaways, clips, user lookup, freezing an account.
#
# These are re-read on every request, so adding or removing an ID takes effect
# immediately — no redeploy, no re-login.
OWNER_DISCORD_IDS=
MOD_DISCORD_IDS=

# ---------------------------------------------------------------------------
# Staging privacy  (middleware.ts)
# ---------------------------------------------------------------------------
# Puts the WHOLE site behind one password. Username is always: matty
# Leave unset to go public. Admin is NOT protected by this — it uses Discord.
SITE_PASSWORD=

# Search engines are kept out unless this is exactly "true".
ALLOW_INDEXING=

# ---------------------------------------------------------------------------
# Not wired up yet — listed so the shape is known. See Master Plan §14.
# ---------------------------------------------------------------------------
# RAZED_REFERRAL_KEY=        # server-side only, NEVER in the client bundle
# KICK_CLIENT_ID=
# KICK_CLIENT_SECRET=
# KICK_WEBHOOK_SECRET=
# DATABASE_URL=
# REDIS_URL=

# Local review only. Lets you play the games without Discord sign-in.
# Impossible in production. Leave unset unless you are testing locally.
DEV_PLAYER_ID=
