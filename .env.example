# MattySpins — every environment variable the app reads.
#
# Copy to .env.local for local development. On Railway, set these on the service.
# Nothing in here is secret; the real values are.

# ============================================================================
# REQUIRED — the site does not function without these
# ============================================================================

# Postgres. Railway sets this for you when you add a Postgres service and
# reference it. The schema creates itself on the first request that touches it.
# Without it: coins, clips, accounts and Kick links do not persist. The site
# still boots and every screen says what is missing.
DATABASE_URL=

# Any long random string. Signs the session cookie.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# The deployed origin, no trailing slash. Locally: http://localhost:3000
# Auth.js builds the OAuth callback from this, so a wrong value breaks sign-in.
AUTH_URL=

# Discord Developer Portal -> your application -> OAuth2.
# Add this redirect URI there, exactly: <AUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Numeric Discord user ids, comma-separated. These accounts get /admin as owner.
# Right-click your name in Discord with Developer Mode on -> Copy User ID.
# Without at least one, /admin refuses everybody.
OWNER_DISCORD_IDS=

# ============================================================================
# REQUIRED before coins can be earned
# ============================================================================

# The referral key from Razed. Server-side only — it is never sent to a browser.
# Without it the leaderboards say "no board to show yet" rather than inventing one.
RAZED_REFERRAL_KEY=

# Any long random string. The scheduler sends it as `Authorization: Bearer ...`
# when calling /api/kick/tick. Without it that endpoint stays closed, and no
# coins are ever awarded for watching.
CRON_SECRET=

# Kick's webhook public key, used to verify every delivery. Optional: if unset,
# it is fetched from Kick once per process. Set it to pin the key.
KICK_WEBHOOK_PUBLIC_KEY=

# ============================================================================
# OPTIONAL
# ============================================================================

# Moderator access to /admin. Owners get everything; mods are capped — for
# example a coin adjustment above 500 MC needs an owner.
MOD_DISCORD_IDS=

# Puts the whole site behind a password (username: matty). Use for a private
# preview. Leave unset to go public.
SITE_PASSWORD=

# Starting balance for a brand-new account. Off unless set, deliberately: every
# coin it mints is one nobody watched for. Useful while testing the games.
WELCOME_COINS=

# Set to `true` only once the legal review has landed. Defaults to
# noindex,nofollow so a draft site cannot be found on Google.
ALLOW_INDEXING=

# ============================================================================
# LOCAL DEVELOPMENT ONLY
# ============================================================================
# Both are impossible in production: the code checks NODE_ENV at build time, so
# a production bundle cannot honour them however the environment is set.

# Opens /admin without Discord.
DEV_ADMIN_BYPASS=

# Signs you in as a stand-in player so the games are usable with no Discord app.
DEV_PLAYER_ID=
DEV_PLAYER_NAME=

# ---------------------------------------------------------------------------
# Kick event subscriptions
#
# Only used by `npm run kick:events`, which tells Kick which events to POST to
# /api/kick/webhook. Nothing at request time reads these — serving the site
# needs neither. Setting the webhook URL in Kick's dashboard says *where*
# deliveries go; the subscription says *what* to deliver, and that call needs
# an app access token.
#
# KICK_WEBHOOK_PUBLIC_KEY is optional: it is Kick's own public key, used to
# verify delivery signatures, and the app fetches it from Kick automatically
# when this is unset. Pinning it here means nobody who can answer DNS for
# api.kick.com can swap it.
# ---------------------------------------------------------------------------
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
